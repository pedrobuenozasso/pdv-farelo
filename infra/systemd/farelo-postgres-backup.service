[Unit]
Description=Farelo OS encrypted offsite PostgreSQL backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
TimeoutStartSec=3h
ExecStart=/opt/farelo-os/current/infra/backup-postgres.sh /opt/farelo-os/shared/.env /etc/farelo/backup.env
