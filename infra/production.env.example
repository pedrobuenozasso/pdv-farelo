# Exemplo; instale os valores reais em /etc/farelo/production.env (chmod 600).
# Não use esta senha nem este JWT em ambiente real.
FARELO_DOMAIN=app.example.com
ACME_EMAIL=operacao@example.com
POSTGRES_DB=farelo
POSTGRES_USER=farelo
POSTGRES_PASSWORD=replace-with-unique-random-secret
JWT_SECRET=replace-with-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MINUTES=480
