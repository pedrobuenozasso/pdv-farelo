{
  "name": "farelo-edge-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Farelo Edge Agent — serviço local (mini PC da cafeteria) responsável por infraestrutura de impressão de dispositivos.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
