<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.farelo</groupId>
    <artifactId>api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api</name>
    <description>Farelo OS — backend (Modular Monolith)</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <!-- FARELO-121: JWT issuance/verification for POST /api/v1/auth/login
             — see com.farelo.api.security.auth.JwtTokenService's javadoc. -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            spring-security-crypto only (NOT spring-boot-starter-security),
            for BCryptPasswordEncoder — see
            com.farelo.api.security.PasswordEncoderConfig's javadoc (FARELO-120)
            for the full reasoning. In short: the full starter auto-configures
            a login-protected filter chain for every endpoint the moment it's
            on the classpath, which would lock down every existing endpoint in
            this codebase (a behavior change far outside this ticket's scope,
            and premature — that's FARELO-121/123/124's job). This module has
            no dependency on spring-security-core/-web/-config, so it doesn't
            trigger any of that autoconfiguration — just the password encoder.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!--
            FARELO-121: standalone JWT library, deliberately NOT
            spring-boot-starter-security — see PasswordEncoderConfig's javadoc
            (FARELO-120) for why this codebase avoids that starter until
            FARELO-123/124 actually need endpoint protection, and
            JwtTokenService's javadoc for the token design itself.
            jjwt-api is the compile-time interface; jjwt-impl (the reference
            implementation) and jjwt-jackson (claims (de)serialization via
            Jackson, already on the classpath via spring-boot-starter-web —
            no need for jjwt's alternative Gson binding) are both
            implementation details, hence runtime-scoped, same as postgresql/
            flyway-database-postgresql above.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
