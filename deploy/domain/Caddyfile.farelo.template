# Farelo public hosts. The system host uses the application's own login/RBAC.
cardapio.farelodebolo.com.br {
    encode gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer

    @catalog path /
    handle @catalog {
        rewrite * /cardapio
        reverse_proxy farelo-os-web-1:3000
    }

    @command path_regexp comanda ^/comanda(100|[1-9][0-9]?)$
    handle @command {
        rewrite * /c/{re.comanda.1}
        reverse_proxy farelo-os-web-1:3000
    }

    @menu path /c/*
    handle @menu {
        reverse_proxy farelo-os-web-1:3000
    }

    @order {
        method POST
        path /api/v1/orders
    }
    handle @order {
        reverse_proxy farelo-os-web-1:3000
    }

    @assets path /_next/* /favicon.ico
    handle @assets {
        reverse_proxy farelo-os-web-1:3000
    }

    handle {
        respond "Página não encontrada" 404
    }
}

sistema.farelodebolo.com.br {
    encode gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer

    handle /api/v1/auth/login {
        reverse_proxy farelo-os-web-1:3000
    }

    handle /api/* {
        reverse_proxy farelo-os-web-1:3000
    }

    @assets path /_next/* /favicon.ico
    handle @assets {
        reverse_proxy farelo-os-web-1:3000
    }

    handle {
        reverse_proxy farelo-os-web-1:3000
    }
}
