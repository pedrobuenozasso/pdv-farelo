# Append to /root/sucao-estoque/Caddyfile after replacing __STAFF_HASH__ with
# the locally generated Argon2id hash. Never commit the filled Caddyfile.
cardapio.farelodebolo.com.br {
    encode gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer

    @catalog path /
    handle @catalog {
        rewrite * /cardapio
        reverse_proxy farelo-os-web-1:3000
    }

    @command path_regexp comanda ^/comanda(100|[1-9][0-9]?)$
    handle @command {
        rewrite * /c/{re.comanda.1}
        reverse_proxy farelo-os-web-1:3000
    }

    @menu path /c/*
    handle @menu {
        reverse_proxy farelo-os-web-1:3000
    }

    @order {
        method POST
        path /api/v1/orders
    }
    handle @order {
        reverse_proxy farelo-os-web-1:3000
    }

    @assets path /_next/* /favicon.ico
    handle @assets {
        reverse_proxy farelo-os-web-1:3000
    }

    handle {
        respond "Página não encontrada" 404
    }
}

sistema.farelodebolo.com.br {
    encode gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer

    handle /api/v1/auth/login {
        basic_auth {
            equipe __STAFF_HASH__
        }
        reverse_proxy farelo-os-web-1:3000 {
            header_up -Authorization
        }
    }

    handle /api/* {
        reverse_proxy farelo-os-web-1:3000
    }

    @assets path /_next/* /favicon.ico
    handle @assets {
        reverse_proxy farelo-os-web-1:3000
    }

    handle {
        basic_auth {
            equipe __STAFF_HASH__
        }
        reverse_proxy farelo-os-web-1:3000
    }
}
