# Exemplo SEM segredos para /opt/farelo-os/shared/offsite.env (OPS-01).
# Copiar para a VPS com: install -m 600 -o root -g root offsite.env.example \
#   /opt/farelo-os/shared/offsite.env  e preencher os valores reais.
# Formato CHAVE=valor; o arquivo é lido sem `source` e chaves desconhecidas
# fazem o envio falhar. Credenciais NUNCA ficam aqui: só no rclone.conf.

# Remoto definido em OFFSITE_RCLONE_CONFIG, no formato "nome:bucket-ou-pasta".
OFFSITE_REMOTE=farelo-offsite:nome-do-bucket
# Pasta dentro do remoto (opcional).
OFFSITE_PREFIX=farelo-os/postgres

# Uma chave PÚBLICA age (age1...) por linha. A chave privada fica com o
# proprietário, fora da VPS; sem ela os backups externos não podem ser lidos.
OFFSITE_AGE_RECIPIENTS_FILE=/opt/farelo-os/shared/offsite-age-recipients.txt
# Configuração do rclone com a credencial do destino (modo 600, fora do Git).
OFFSITE_RCLONE_CONFIG=/opt/farelo-os/shared/rclone.conf

# Retenção no destino: o objeto mais novo de cada um dos N dias, M semanas ISO
# e K meses mais recentes (UTC). 0 desativa semanal/mensal; diário mínimo 1.
OFFSITE_KEEP_DAILY=14
OFFSITE_KEEP_WEEKLY=8
OFFSITE_KEEP_MONTHLY=12
# 1 = este script apaga o que sai da retenção. 0 = não apaga nada (usar quando
# a credencial não tem permissão de apagar e a retenção é regra do provedor).
OFFSITE_PRUNE=1

# Recusa enviar se o dump local mais novo tiver mais horas que isto.
OFFSITE_MAX_LOCAL_AGE_HOURS=26
